{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (debug)",
            "type": "shell",
            "command": "clang++",
            "args": [
                "./platform_backends/sdl_platform_layer.cpp",
                "-std=c++11",
                "-g",
                "-arch",
                "arm64",
                "-arch",
                "x86_64",
                "-Wno-deprecated-declarations",
                "-Wno-writable-strings",
                "-Wno-c++11-compat-deprecated-writable-strings",
                "-iframework",
                "/Library/Frameworks/SDL3.xcframework/macos-arm64_x86_64",
                "-iframework",
                "/Library/Frameworks/SDL3_image.xcframework/macos-arm64_x86_64",
                "-iframework",
                "/Library/Frameworks/SDL3_ttf.xcframework/macos-arm64_x86_64",
                "-F",
                "/Library/Frameworks/SDL3.xcframework/macos-arm64_x86_64",
                "-F",
                "/Library/Frameworks/SDL3_image.xcframework/macos-arm64_x86_64",
                "-F",
                "/Library/Frameworks/SDL3_ttf.xcframework/macos-arm64_x86_64",
                "-framework",
                "SDL3",
                "-framework",
                "SDL3_image",
                "-framework",
                "SDL3_ttf",
                "-Wl,-rpath,@executable_path/../Frameworks",
                "-Wl,-rpath,/Library/Frameworks/SDL3.xcframework/macos-arm64_x86_64",
                "-Wl,-rpath,/Library/Frameworks/SDL3_image.xcframework/macos-arm64_x86_64",
                "-Wl,-rpath,/Library/Frameworks/SDL3_ttf.xcframework/macos-arm64_x86_64",
                "-o",
                "./bin/KenKen"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$clang"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang build active file",
            "command": "/usr/bin/clang",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}