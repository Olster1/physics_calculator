{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (debug)",
            "type": "shell",
            "command": "clang++",
            "args": [
                "./platform_backends/sdl_platform_layer.cpp",
                "-std=c++11",
                "-g",
                "-arch", "arm64", 
                "-I", "./libs/GLAD/include",
                "-Wno-deprecated-declarations",
                "-Wno-writable-strings",
                "-Wno-c++11-compat-deprecated-writable-strings",
                "-Wno-tautological-compare",
                "-iframework", "/Library/Frameworks/SDL3.xcframework/macos-arm64_x86_64",
                "-F", "/Library/Frameworks/SDL3.xcframework/macos-arm64_x86_64",
                "-framework", "SDL3",
                "-framework", "OpenGL",
                "-Wl,-rpath,@executable_path/../Frameworks",
                "-Wl,-rpath,/Library/Frameworks/SDL3.xcframework/macos-arm64_x86_64",
                "-o", "./bin/Calculator"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$strike-clang"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}